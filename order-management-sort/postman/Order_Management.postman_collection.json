    {
      "name": "Sort price descending",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/orders/sort?sortBy=totalPrice&dir=desc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "orders",
            "sort"
          ],
          "query": [
            {
              "key": "sortBy",
              "value": "totalPrice"
            },
            {
              "key": "dir",
              "value": "desc"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const data = pm.response.json();",
              "pm.test(\"20 sample orders\", () => { pm.expect(data).to.be.an(\"array\"); pm.expect(data.length).to.eql(20); });",
              "const values = data.map(o => o.totalPrice);",
              "pm.test(\"All sort values are numeric\", () => values.forEach(v => { pm.expect(v).to.be.a(\"number\"); pm.expect(Number.isFinite(v)).to.eql(true); }));",
              "pm.test(\"Correct order for every adjacent pair\", () => { for (let i = 1; i < values.length; i++) { pm.expect(values[i-1]).to.be.at.least(values[i]); } });"
            ]
          }
        }
      ]
    },
